{
  "name": "opencode-foundry-launcher",
  "version": "1.0.0",
  "description": "OpenCode in self-hosted Daytona sandboxes, defaulted to Azure AI Foundry, gated by Entra SSO. Firm-internal, VNet-deployed.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc && node dist/server.js",
    "setup": "node setup.mjs"
  },
  "keywords": [
    "opencode",
    "daytona",
    "render",
    "sandbox"
  ],
  "license": "MIT",
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/msal-node": "^5.2.4",
    "@daytona/sdk": "^0.186.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.8.0",
    "typescript": "^5.4.0"
  }
}
