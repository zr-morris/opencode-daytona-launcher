# ---------------------------------------------------------------------------
# All of these are OPTIONAL.
#
# The normal way to use this app is to enter your keys in the web UI (Settings),
# where they are stored in your browser and sent per-request. The server is
# stateless and never stores keys.
#
# These env vars exist ONLY as convenience fallbacks for operators who would
# rather pre-bake credentials into a deployment. A request header always takes
# precedence over the matching env var.
# ---------------------------------------------------------------------------

# Fallback Daytona API key (used to create sandboxes when no X-Daytona-Key header).
DAYTONA_API_KEY=
# Fallback Daytona region (us | eu). Defaults to "us".
DAYTONA_TARGET=
# Fallback GitHub token injected into sandboxes (clone/push/PR).
GITHUB_TOKEN=
# Fallback Linear personal API key + team id (issue/PR linking).
LINEAR_API_KEY=
LINEAR_TEAM_ID=
# Fallback Render API key (self-host automation / future deploy features).
RENDER_API_KEY=
# Optional: persisted into each sandbox (OpenCode handles LLMs natively).
OPENAI_API_KEY=

# Render injects PORT automatically; default 3000 for local runs.
PORT=3000

# ---------------------------------------------------------------------------
# Optional: GitHub OAuth login gate.
# Set BOTH client id + secret to REQUIRE GitHub login before anyone can use the
# instance. The login also auto-provisions GitHub for OpenCode (the OAuth token,
# repo scope, is injected into sandboxes — no PAT needed). Leave unset to keep
# the app open (no login).
# Create an OAuth app at https://github.com/settings/developers
#   Homepage URL:               https://your-service.onrender.com
#   Authorization callback URL: https://your-service.onrender.com/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Strongly recommended when login is enabled: restrict who may sign in.
# Comma-separated GitHub usernames, and/or a single GitHub org (members allowed).
ALLOWED_GITHUB_USERS=
ALLOWED_GITHUB_ORG=
# Secret used to sign session cookies. Set a long random value in production so
# sessions survive restarts. If unset, a random per-boot secret is used.
SESSION_SECRET=
# Optional: force the external base URL used for the OAuth callback (otherwise
# derived from request/proxy headers). e.g. https://your-service.onrender.com
APP_BASE_URL=
