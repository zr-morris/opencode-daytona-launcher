# ---------------------------------------------------------------------------
# All of these are OPTIONAL.
#
# The normal way to use this app is to enter your keys in the web UI (Settings),
# where they are stored in your browser and sent per-request. The server is
# stateless and never stores keys.
#
# These env vars exist ONLY as convenience fallbacks for operators who would
# rather pre-bake credentials into a deployment. A request header always takes
# precedence over the matching env var.
# ---------------------------------------------------------------------------

# Fallback Daytona API key (used to create sandboxes when no X-Daytona-Key header).
DAYTONA_API_KEY=
# Fallback Daytona region (us | eu). Defaults to "us".
DAYTONA_TARGET=
# Fallback GitHub token injected into sandboxes (clone/push/PR).
GITHUB_TOKEN=
# Fallback Linear personal API key + team id (issue/PR linking).
LINEAR_API_KEY=
LINEAR_TEAM_ID=
# Fallback Render API key (self-host automation / future deploy features).
RENDER_API_KEY=
# Optional: persisted into each sandbox (OpenCode handles LLMs natively).
OPENAI_API_KEY=

# Render injects PORT automatically; default 3000 for local runs.
PORT=3000
