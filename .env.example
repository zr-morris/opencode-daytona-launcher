# ---------------------------------------------------------------------------
# OpenCode (Azure Foundry edition). These are normally written by `npm run setup`.
# This file documents the variables; do not put real secrets here.
# Copy to .env (gitignored) or let setup generate it.
# ---------------------------------------------------------------------------

# --- Self-hosted Daytona (control plane that runs the sandboxes, IN your VNet) ---
DAYTONA_API_URL=https://daytona.your-firm.internal/api
DAYTONA_API_KEY=
DAYTONA_TARGET=

# --- Azure AI Foundry ---
AZURE_FOUNDRY_BASE_URL=https://your-resource.services.ai.azure.com
# Blank for the v1 GA API; otherwise e.g. 2025-04-01-preview
AZURE_API_VERSION=
AZURE_DEFAULT_DEPLOYMENT=gpt-4o
# 'entra' (managed identity, recommended) or 'apikey'
AZURE_AUTH_MODE=entra
# Only used when AZURE_AUTH_MODE=apikey
AZURE_API_KEY=
AZURE_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default

# --- Corporate Entra SSO (app login). Leave blank to disable sign-in. ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Long random string; signs session cookies (generated by setup if blank)
SESSION_SECRET=
# Where users reach the app; used for the SSO redirect URI
APP_BASE_URL=https://opencode.your-firm.internal

# Injected by the platform; default 3000 for local runs
PORT=3000
